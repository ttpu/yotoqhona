generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  UNIVERSITY_ADMIN
  HOSTEL_ADMIN
  LANDLORD
  SUPER_ADMIN
}

enum HousingType {
  DORMITORY
  HOSTEL
  APARTMENT
}

enum Gender {
  MALE
  FEMALE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

enum PaymentProvider {
  CLICK
  PAYME
  UZUM
  PAYNET
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phone       String?
  role        UserRole
  pinfl       String?  @unique
  gender      Gender?
  university  String?
  faculty     String?
  course      Int?
  createdAt   DateTime @default(now())

  applications Application[]
  payments     Payment[]
  reviews      Review[]
  queueEntries QueueEntry[]
}

model Housing {
  id              String      @id @default(cuid())
  name            String
  type            HousingType
  region          String
  district        String
  city            String
  address         String
  university      String
  distanceKm      Float
  rating          Float       @default(0)
  verified        Boolean     @default(false)
  monthlyPrice    Int
  availableBeds   Int
  totalBeds       Int
  rules           String[]
  amenities       String[]
  images          String[]
  genderPolicy    Gender?
  createdAt       DateTime    @default(now())

  rooms         Room[]
  applications  Application[]
  queueEntries  QueueEntry[]
  reviews       Review[]
}

model Room {
  id            String   @id @default(cuid())
  housingId     String
  roomNumber    String
  capacity      Int
  occupiedBeds  Int      @default(0)
  genderPolicy  Gender?

  housing       Housing   @relation(fields: [housingId], references: [id], onDelete: Cascade)
}

model Application {
  id            String            @id @default(cuid())
  userId         String
  housingId      String
  status         ApplicationStatus @default(SUBMITTED)
  createdAt      DateTime          @default(now())

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  housing        Housing @relation(fields: [housingId], references: [id], onDelete: Cascade)
}

model QueueEntry {
  id             String   @id @default(cuid())
  userId         String
  housingId      String
  position       Int
  priorityScore  Int
  joinedAt       DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  housing        Housing  @relation(fields: [housingId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String           @id @default(cuid())
  paymentId     String           @unique
  userId        String
  amount        Int
  provider      PaymentProvider
  success       Boolean          @default(false)
  receiptUrl    String?
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  userId       String
  housingId    String
  score        Int
  comment      String
  createdAt    DateTime @default(now())

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  housing     Housing @relation(fields: [housingId], references: [id], onDelete: Cascade)
}
